+void Greeter::stop() {
+  // check flag
+  if (!m_started)
+    return;
+
+  // log message
+  qDebug() << "Greeter stopping...";
+
+  if (m_dbusProcess) {
+    m_dbusProcess->terminate();
+    if (!m_dbusProcess->waitForFinished(2000))
+      m_dbusProcess->kill();
+  }
+
+  if (daemonApp->testing()) {
+    // terminate process
+    m_process->terminate();
+
+    // wait for finished
+    if (!m_process->waitForFinished(5000))
+      m_process->kill();
+  } else {
+    m_auth->stop();
+  }
+}
 
